[run]
source =
    cyberdeck

[report]
show_missing = True
skip_covered = False
precision = 1
fail_under = 80
include =
    cyberdeck/api/core.py
    cyberdeck/api/local.py
    cyberdeck/auth.py
    cyberdeck/net.py
    cyberdeck/pin_limiter.py
    cyberdeck/protocol.py
    cyberdeck/qr_auth.py
    cyberdeck/video/stream_adaptation.py
    cyberdeck/ws/protocol.py
